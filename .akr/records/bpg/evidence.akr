record bpg.evidence.psy-rd-shape-match/1 : evidence {
    title "psy_rd_weight matches x265's weighting shape"
    state verified
    result pass
    method command
    observed_at git:aa273f46f02f7f682369da49ca06b3bbcf85e6e6
    command "cargo test -p still265 psy_rd_weight_matches_x265_shape"
    summary """
        The ported psy-rd energy weight kernel (factor = psy_rd * 0.33 *
        (96.0/256.0), tapered above QP 40, zero at QP>=51) matches x265's
        rdcost.h formula shape; env overrides BPG_PSY_RD (clamp 0..=5) and
        BPG_PSY_RDOQ (clamp 0..=50) resolve as designed.
        """
    created_at 2026-07-18
    source {
        kind legacy
        path "docs/psy-design.md"
        excerpt """
            Weight (rdcost.h:42-65) ... Sane ranges 0..=5 ... 0..=50 ...
            Env overrides ... BPG_PSY_RD, BPG_PSY_RDOQ.
            """
    }
}

record bpg.evidence.rdoq-int64-neutral/1 : evidence {
    title "RDOQ int64 fixed-point port: BD-neutral, -1% single-thread wall"
    state verified
    result pass
    method command
    observed_at git:edf12d7785c73e4994e542159ca73af665521f7c
    summary """
        Porting RDOQ's cost domain from f64 to x265's exact int64 fixed
        point: BD-rate +0.002% (12 MP) / +0.0001% (50 MP) over QP 22-34 -
        neutral; wall -1% single-thread. The f64 arithmetic was not the
        RDOQ bottleneck.
        """
    created_at 2026-07-06
    source {
        kind legacy
        path "docs/x265-speed-parity-audit.md"
        excerpt """
            BD-rate +0.002% (12 MP) / +0.0001% (50 MP) over QP 22-34 -
            neutral; wall -1% single-thread. The f64 arithmetic was not
            the RDOQ bottleneck.
            """
    }
}

record bpg.evidence.root-tu-dedup-hit-rate/1 : evidence {
    title "Root-TU dedup: 100% hit rate, -3.9% single-thread CPU"
    state verified
    result pass
    method command
    observed_at git:bae552ad70f80b708a3a3014fe04b560fb24877c
    command "bpg-highres-compare --native --sizes 12MP --efforts slow -q 28"
    summary """
        root_tu_reuse_hits == cu_trials exactly on the 12 MP canonical case
        (100% hit rate). Interleaved A/B: 12 MP mean 1.567s vs 1.595s
        (-1.8%), 50 MP 2.36s vs 2.43s (-2.6%); single-thread 12 MP 10.21s vs
        10.64s (-3.9% CPU).
        """
    created_at 2026-07-07
    source {
        kind legacy
        path "docs/x265-speed-parity-audit.md"
        excerpt """
            Hit rate 100% - root_tu_reuse_hits ... = 182,340 = cu_trials
            exactly on the 12 MP canonical.
            """
    }
}

record bpg.evidence.slow-oracle-rejection/1 : evidence {
    title "Legacy cheap-top-1 Slow rejected by 10-source sparse-oracle sampling"
    state verified
    result fail
    method command
    observed_at git:4e68042a4b731a4f73096f3ccc0988631d789dce
    summary """
        10-source sparse-oracle sampling of the legacy cheap-top-1 search
        path found 146 misses in 301 samples (48.5%), only 155 cheap-top-1
        hits (51.5%). The result rejects legacy cheap-top-1 Slow as the
        canonical m9 path: oracle misses are meaningful, not rare.
        """
    created_at 2026-06-26
    source {
        kind legacy
        path "docs/still265-pre-simd-audit.md"
        excerpt """
            Follow-up 10-source sparse-oracle sampling of the legacy
            cheap-top-1 path found 146 misses in 301 samples (48.5%) with
            only 155 cheap-top-1 hits (51.5%).
            """
    }
}

