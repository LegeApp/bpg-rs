record bpg.evidence.finalize-skip-attempt-failed/1 : evidence {
    title "Finalize re-code skip: attempted and reverted"
    state verified
    result fail
    method command
    observed_at git:680d91e41657fbb7dee13375d07e26b39a8a6b05
    summary """
        The retained-search coefficients/recon are not a drop-in substitute
        for the decoder-order RdoqFinal walk; the finalize pass is
        currently load-bearing for recon/decode equality. The divergence is
        broad enough that the attempted skip was reverted rather than
        shipped.
        """
    created_at 2026-07-06
    source {
        kind legacy
        path "docs/x265-speed-parity-audit.md"
        excerpt """
            Attempted and reverted ... the finalize pass is currently
            load-bearing for recon/decode equality - the retained search
            coefficients/recon are not a drop-in substitute for the
            decoder-order RdoqFinal walk.
            """
    }
}

record bpg.evidence.parity-sweep-1-016x/1 : evidence {
    title "Final 7-image sweep: aggregate 1.016x vs bpgenc -m9"
    state verified
    result pass
    method command
    observed_at git:bae552ad70f80b708a3a3014fe04b560fb24877c
    artifact "README.md"
    summary """
        Seven 12MP/50MP native photos, still265 slow QP 28 native mode,
        release-lto build, best-of-2 idle desktop, vs on-PATH x265 4.1
        `bpgenc -m9`: aggregate 14.36s vs 14.14s, ratio 1.016x. Two images
        faster than C; the remaining tail is mostly textured 12 MP inputs.
        Mean of per-image ratios 1.036x, median 1.044x.
        """
    created_at 2026-07-07
    source {
        kind legacy
        path "README.md"
        excerpt """
            the latest 7-image sweep is 1.016x aggregate against `bpgenc
            -m9`, with two images faster than C and the remaining tail
            mostly in textured 12 MP inputs.
            """
    }
}

