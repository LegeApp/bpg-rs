    observed_at git:d87aee7ddedccc9a9a33c9c58ec3da4b460897fd
    summary """
        The known-good historical baseline table records the aggregate
        still265-vs-bpgenc-m9 ratio before the large speed-parity refactors
        as 1.9-2.5x. The nearest identifiable commit for this pre-refactor
        architecture state is the full intra encoder / x265 intra-search
        parity commit; no single dedicated benchmark commit is separately
        tagged for the baseline figure itself.
        """
    created_at 2026-07-14
    source {
        kind legacy
        path "docs/optimization-testing-plan.md"
