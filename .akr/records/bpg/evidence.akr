record bpg.evidence.chroma-calibration/1 : evidence {
    title "Chroma search calibration: keeps ~98% of RGB gain at ~27% less added time"
    state verified
    result pass
    method command
    observed_at git:4bc91bb9d2ee6d51a8ebc41369f9304a1f13a7ff
    summary """
        New chroma default (K=1, skip off) vs old exhaustive: RGB BD-rate
        -0.358% vs -0.365% (old), time +20.1% vs +27.5% (old), exact
        non-DM candidates cut from 1,629,632 to 407,144. Retains ~98% of the
        chroma RGB gain while cutting ~75% of the exact chroma work.
        """
    created_at 2026-07-03
    source {
        kind legacy
        path "docs/handoff2.md"
        excerpt """
            The new default retains ~98% of the chroma RGB gain while
            cutting ~75% of the exact chroma work and ~27% of the added time
            on this set.
            """
    }
}

